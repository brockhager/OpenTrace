# .env.example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Required: PostgreSQL database connection
# For Railway: Use Railway's auto-generated DATABASE_URL (it will be automatically converted from postgresql:// to postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# Required: JWT secret key (must be at least 32 characters)
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_chars_long

# Optional: Log retention in days (default: 30)
LOG_RETENTION_DAYS=30

# Optional: Rate limiting window in hours (default: 1)
RATE_LIMIT_WINDOW_HOURS=1

# Optional: Maximum search results to return (default: 50)
MAX_SEARCH_RESULTS=50

# Optional: PDF processing timeout in seconds (default: 30)
PDF_PROCESSING_TIMEOUT=30